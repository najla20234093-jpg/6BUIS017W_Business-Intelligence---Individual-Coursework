            "K-means RFM\n",
            " k  inertia  silhouette  min_size                             sizes  seed_ARI\n",
            " 2   1066.8       0.423        68                         [418, 68]     1.000\n",
            " 3    796.6       0.325        64                    [270, 152, 64]     0.991\n",
            " 4    609.8       0.341        61                [122, 61, 212, 91]     0.994\n",
            " 5    514.7       0.358        11            [68, 122, 87, 11, 198]     1.000\n",
            " 6    437.4       0.347        11       [105, 143, 40, 11, 120, 67]     0.967\n",
