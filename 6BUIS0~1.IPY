        }
      ],
      "source": [
        "\n",
        "OBS_DATE = adj[keep + [BENCH]].dropna(how=\"any\").index.max()\n",
        "v, c = vol.loc[:OBS_DATE, keep], close.loc[:OBS_DATE, keep]\n",
        "\n",
        "base = v.shift(1).rolling(20).mean()\n",
        "event = v > 2 * base\n",
        "win = v.index[-60:]\n",
        "\n",
        "# 1.4.1 Recency (R)\n",
        "last_event = event.apply(lambda s: s[s].index.max() if s.any() else pd.NaT)\n",
        "last_event = pd.to_datetime(last_event)\n",
        "R = (OBS_DATE - last_event).dt.days.astype(float)\n",
        "\n",
        "print(\"Task 1.4.1 Recency summary:\")\n",
        "display(R.describe().to_frame(\"Recency_days\").round(2))\n"
      ],
      "id": "d4F1GlASBGcR"
    },
