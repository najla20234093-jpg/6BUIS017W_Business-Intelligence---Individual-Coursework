              "summary": "{\n  \"name\": \"display(pd\",\n  \"rows\": 2,\n  \"fields\": [\n    {\n      \"column\": \"RFM Ward\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0,\n        \"min\": 1,\n        \"max\": 2,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          2,\n          1\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": 1,\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 264,\n        \"min\": 22,\n        \"max\": 396,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          22,\n          396\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": 2,\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 36,\n        \"min\": 8,\n        \"max\": 60,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          60,\n          8\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
            }
          },
          "metadata": {}
        }
      ],
      "source": [
        "from sklearn.decomposition import PCA\n",
        "def relabel(lab, key):                         # number clusters 1..k by ascending mean of key\n",
        "    order = pd.Series(np.asarray(key)).groupby(lab).mean().sort_values().index\n",
        "    return pd.Series(lab).map({o: i + 1 for i, o in enumerate(order)}).values\n",
        "feat[\"RR_Ward\"]  = relabel(fcluster(Z[\"RR\"],  K_WARD[\"RR\"],  \"maxclust\") - 1, feat.Beta)\n",
        "feat[\"RR_KM\"]    = relabel(KMeans(K_KM[\"RR\"],  n_init=50, random_state=SEED).fit_predict(X_rr),  feat.Beta)\n",
        "feat[\"RFM_Ward\"] = relabel(fcluster(Z[\"RFM\"], K_WARD[\"RFM\"], \"maxclust\") - 1, feat.logM)\n",
        "feat[\"RFM_KM\"]   = relabel(KMeans(K_KM[\"RFM\"], n_init=50, random_state=SEED).fit_predict(X_rfm), feat.logM)\n",
        "feat[\"Return_pct\"], feat[\"M_bn\"] = feat.MeanWeeklyReturn * 100, feat.M / 1e9\n",
        "\n",
        "def profile(col, cols):                        # mean and median in ORIGINAL units, plus cluster size\n",
        "    g = feat.groupby(col)[cols].agg([\"mean\", \"median\"]); g.columns = [f\"{a}_{b}\" for a, b in g.columns]\n",
        "    return g.join(feat.groupby(col).size().rename(\"n\")).round(2)\n",
        "for col in [\"RR_Ward\", \"RR_KM\"]:   print(f\"\\n{col} (return in %, beta)\");     display(profile(col, [\"Return_pct\", \"Beta\"]))\n",
        "for col in [\"RFM_Ward\", \"RFM_KM\"]: print(f\"\\n{col} (R, F in days, M in USD bn)\"); display(profile(col, [\"R\", \"F\", \"M_bn\"]))\n",
        "\n",
        "# 2D plots: risk/return plotted directly, RFM via PCA (visual aid only, 3 standardised features -> 2 components)\n",
        "pca = PCA(2, random_state=SEED).fit(X_rfm); P = pca.transform(X_rfm)\n",
        "print(\"PCA variance explained:\", pca.explained_variance_ratio_.round(3), \"| loadings (R, F, logM):\", pca.components_.round(2).tolist())\n",
        "def scat(ax, x, y, lab, xl, yl, ttl):\n",
        "    ax.scatter(x, y, c=lab, cmap=\"tab10\", s=14, alpha=.75)\n",
        "    for c in np.unique(lab): ax.annotate(f\"C{c}\", (x[lab == c].mean(), y[lab == c].mean()), weight=\"bold\", bbox=dict(boxstyle=\"round\", fc=\"white\", alpha=.8))\n",
        "    ax.set_xlabel(xl); ax.set_ylabel(yl); ax.set_title(ttl)\n",
        "fig, ax = plt.subplots(2, 2, figsize=(13, 10))\n",
        "for a, col, nm in [(ax[0, 0], \"RR_Ward\", \"Ward\"), (ax[0, 1], \"RR_KM\", \"K-means\")]:\n",
        "    scat(a, feat.Beta.values, feat.Return_pct.values, feat[col].values, \"Weekly beta\", \"Mean weekly return (%)\", f\"Risk/return, {nm} (k={feat[col].nunique()})\")\n",
        "for a, col, nm in [(ax[1, 0], \"RFM_Ward\", \"Ward\"), (ax[1, 1], \"RFM_KM\", \"K-means\")]:\n",
        "    scat(a, P[:, 0], P[:, 1], feat[col].values, f\"PC1 ({pca.explained_variance_ratio_[0]:.0%})\", f\"PC2 ({pca.explained_variance_ratio_[1]:.0%})\", f\"RFM (PCA), {nm} (k={feat[col].nunique()})\")\n",
        "plt.tight_layout(); plt.savefig(\"outputs/cluster_scatter.png\", dpi=150); plt.show()\n",
        "\n",
        "# algorithm comparison on the same shares\n",
        "print(\"ARI Ward vs K-means | risk/return:\", round(adjusted_rand_score(feat.RR_Ward, feat.RR_KM), 3), \"| RFM:\", round(adjusted_rand_score(feat.RFM_Ward, feat.RFM_KM), 3))\n",
        "display(pd.crosstab(feat.RR_Ward, feat.RR_KM, rownames=[\"RR Ward\"], colnames=[\"RR K-means\"]))\n",
        "display(pd.crosstab(feat.RFM_Ward, feat.RFM_KM, rownames=[\"RFM Ward\"], colnames=[\"RFM K-means\"]))\n"
      ],
      "id": "4TeiQGYmBGcU"
    },
