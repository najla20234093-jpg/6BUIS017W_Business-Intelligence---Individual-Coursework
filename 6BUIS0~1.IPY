      "source": [
        "## Task 3.2.2 — Sensitivity findings and business uses"
      ],
      "id": "bOi9bpFqBGcY"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "nD99zZY4BGcY"
      },
      "outputs": [],
      "source": [
        "# 3.2.2 Sensitivity findings and business uses\n",
        "if \"logM\" not in feat: feat[\"logM\"] = np.log1p(feat.M_bn * 1e9)\n",
        "\n",
        "def eta2(x, g):\n",
        "    x, g = np.asarray(x), np.asarray(g)\n",
        "    return sum((g == k).sum() * (x[g == k].mean() - x.mean()) ** 2 for k in np.unique(g)) / ((x - x.mean()) ** 2).sum()\n",
        "\n",
        "# correlations between the RFM inputs\n",
        "print(f\"R-F {feat.R.corr(feat.F):.2f} | R-logM {feat.R.corr(feat.logM):.2f} | F-logM {feat.F.corr(feat.logM):.2f}\")\n",
        "print(f\"PC1 share of variance: {PCA().fit(X_rfm).explained_variance_ratio_[0]:.2f}\")\n",
        "\n",
        "# monetary removal comparison\n",
        "print(f\"ARI full RFM vs R,F only: {adjusted_rand_score(feat.RFM_Ward, feat.RF_Ward):.3f}\")\n",
        "print(f\"eta2 of log traded value: full {eta2(feat.logM, feat.RFM_Ward):.3f} | R,F only {eta2(feat.logM, feat.RF_Ward):.3f}\")\n",
        "\n",
        "watch = feat.sort_values([\"F\", \"R\"], ascending=[False, True]).head(10)[[\"Sector\", \"R\", \"F\", \"M_bn\", \"RFM_Ward\"]]\n",
        "display(watch.round(2))\n",
        "\n",
        "# portfolio analysis, equal-weight portfolio of each risk/return cluster\n",
        "rows = []\n",
        "for c in sorted(feat.RR_Ward.unique()):\n",
        "    tk = feat.index[feat.RR_Ward == c]\n",
        "    pr = wret[tk].mean(axis=1)\n",
        "    rows.append(dict(cluster=c, shares=len(tk),\n",
        "                     portfolio_beta=round(pr.cov(wret[BENCH]) / wret[BENCH].var(), 2),\n",
        "                     avg_share_vol_pct=round(wret[tk].std().mean() * 100, 2),\n",
        "                     portfolio_vol_pct=round(pr.std() * 100, 2),\n",
        "                     avg_pairwise_corr=round((wret[tk].corr().values.sum() - len(tk)) / (len(tk) * (len(tk) - 1)), 2)))\n",
        "display(pd.DataFrame(rows))\n"
      ],
      "id": "nD99zZY4BGcY"
    },
