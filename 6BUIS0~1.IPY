      ],
      "source": [
        "# 1.3 Mean weekly return and weekly beta (needs keep, wk, wret, BENCH from 1.2)\n",
        "bench, ret = wret[BENCH], wret[keep]\n",
        "N = len(wret)\n",
        "\n",
        "# 1.3.1 mean weekly return: arithmetic mean of Friday-ending weekly adjusted-close returns, full period\n",
        "mean_ret = ret.mean()\n",
        "geo_ret = (1 + ret).prod() ** (1 / N) - 1  # compounded equivalent, to show the limitation of the arithmetic mean\n",
        "\n",
        "print(\"Mean weekly return summary:\")\n",
        "display(mean_ret.describe().to_frame(\"Mean_Weekly_Return\").round(5))\n"
      ],
      "id": "F-Yz6HiWBGcP"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "foE1TwXABGcP"
      },
      "source": [
        "## Task 1.3.2 — Weekly beta"
      ],
      "id": "foE1TwXABGcP"
    },
    {
      "cell_type": "code",
      "execution_count": 45,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "OgcVmRlhBGcP",
        "outputId": "4b7553bd-a55b-45d4-a7eb-66ef06fa37e2"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Weekly returns: Friday-ending adjusted closes, 2021-01-15 to 2024-12-27, N = 207 per share and benchmark\n",
            "Mean weekly return: median 0.2619%, range -0.4468% to 1.7772% | median arithmetic-minus-geometric gap 0.0743%\n",
            "Adjusted price basis used because 21 shares have dividend/adjustment gaps between Close and Adj Close; benchmark ^GSPC is a price index\n",
            "Beta: median 0.95, range 0.06 to 3.78 | median SE 0.101 (95% interval about +/-0.20)\n",
            "Beta below 0: 0 | above 2: 9 | median |beta first half - second half|: 0.21\n",
            "Checks passed: hand-computed week, beta = OLS slope, benchmark beta = 1, no missing weeks.\n"
          ]
        }
      ],
      "source": [
        "# 1.3.2 weekly beta = cov(share, benchmark) / var(benchmark), sample statistics on the same N matched weeks\n",
        "beta = ret.apply(lambda s: s.cov(bench)) / bench.var()\n",
        "se = np.sqrt(((ret.sub(ret.mean()) - np.outer(bench - bench.mean(), beta)) ** 2).sum() / (N - 2) / ((bench - bench.mean()) ** 2).sum())\n",
        "half = N // 2\n",
        "b2 = ret.iloc[half:].apply(lambda s: s.cov(bench.iloc[half:])) / bench.iloc[half:].var()\n",
        "feat13 = pd.DataFrame({\"MeanWeeklyReturn\": mean_ret, \"GeoMeanWeeklyReturn\": geo_ret, \"Beta\": beta, \"Beta_SE\": se, \"N_weeks\": N})\n",
        "os.makedirs(\"outputs\", exist_ok=True)\n",
        "feat13.to_csv(\"outputs/weekly_return_beta.csv\")\n",
        "\n",
        "\n",
        "t, wk_date = keep[0], wret.index[10]; prev = wk.index[wk.index.get_loc(wk_date) - 1]\n",
        "assert np.isclose(wret.loc[wk_date, t], wk.loc[wk_date, t] / wk.loc[prev, t] - 1)\n",
        "assert all(np.isclose(beta[s], np.polyfit(bench, ret[s], 1)[0]) for s in keep[:5])\n",
        "assert np.isclose(bench.cov(bench) / bench.var(), 1) and ret.notna().all().all() and ret.shape[0] == N\n",
        "adj_gap = ((close[keep].pct_change(fill_method=None) - adj[keep].pct_change(fill_method=None)).abs() > 0.02).any().sum()\n",
        "\n",
        "print(f\"Weekly returns: Friday-ending adjusted closes, {wret.index[0].date()} to {wret.index[-1].date()}, N = {N} per share and benchmark\")\n",
        "print(f\"Mean weekly return: median {mean_ret.median():.4%}, range {mean_ret.min():.4%} to {mean_ret.max():.4%} | median arithmetic-minus-geometric gap {(mean_ret - geo_ret).median():.4%}\")\n",
        "print(f\"Adjusted price basis used because {adj_gap} shares have dividend/adjustment gaps between Close and Adj Close; benchmark ^GSPC is a price index\")\n",
        "print(f\"Beta: median {beta.median():.2f}, range {beta.min():.2f} to {beta.max():.2f} | median SE {se.median():.3f} (95% interval about +/-{1.96*se.median():.2f})\")\n",
        "print(f\"Beta below 0: {(beta < 0).sum()} | above 2: {(beta > 2).sum()} | median |beta first half - second half|: {(b1 - b2).abs().median():.2f}\")\n",
        "print(\"Checks passed: hand-computed week, beta = OLS slope, benchmark beta = 1, no missing weeks.\")\n"
      ],
      "id": "OgcVmRlhBGcP"
    },
