      "source": [
        "# 3.2.1 Cluster profiles and sector composition\n",
        "feat[\"Sector\"] = cons.set_index(\"Ticker\")[\"GICS Sector\"].reindex(feat.index)\n",
        "\n",
        "# Profiles in original units (medians) for both solutions\n",
        "rr = feat.groupby(\"RR_Ward\").agg(n=(\"Beta\", \"size\"), Return_pct=(\"Return_pct\", \"median\"), Beta=(\"Beta\", \"median\"),\n",
        "                                 R=(\"R\", \"median\"), F=(\"F\", \"median\"), M_bn=(\"M_bn\", \"median\")).round(2)\n",
        "rfm = feat.groupby(\"RFM_Ward\").agg(n=(\"Beta\", \"size\"), R=(\"R\", \"median\"), F=(\"F\", \"median\"), M_bn=(\"M_bn\", \"median\"),\n",
        "                                   Return_pct=(\"Return_pct\", \"median\"), Beta=(\"Beta\", \"median\")).round(2)\n",
        "print(\"Risk/return clusters\"); display(rr)\n",
        "print(\"RFM clusters\"); display(rfm)\n",
        "print(\"ARI risk/return vs RFM:\", round(adjusted_rand_score(feat.RR_Ward, feat.RFM_Ward), 3))\n",
        "display(pd.crosstab(feat.RR_Ward, feat.RFM_Ward, rownames=[\"RR\"], colnames=[\"RFM\"]))\n",
        "\n",
        "# Sector composition of each cluster, compared with the overall sector mix\n",
        "overall = feat.Sector.value_counts(normalize=True) * 100\n",
        "fig, ax = plt.subplots(1, 2, figsize=(15, 5))\n",
        "for a, col, title in [(ax[0], \"RR_Ward\", \"Risk/return clusters\"), (ax[1], \"RFM_Ward\", \"RFM clusters\")]:\n",
        "    ct = pd.crosstab(feat[col], feat.Sector, normalize=\"index\") * 100\n",
        "    ct.plot(kind=\"bar\", stacked=True, ax=a, colormap=\"tab20\", legend=False)\n",
        "    a.set_title(\"Sector mix: \" + title); a.set_xlabel(\"cluster\"); a.set_ylabel(\"% of cluster\")\n",
        "    print(title, \": cluster minus overall (percentage points)\"); display((ct - overall).round(1))\n",
        "ax[1].legend(loc=\"center left\", bbox_to_anchor=(1, .5), fontsize=8)\n",
        "plt.tight_layout(); plt.savefig(\"outputs/sector_composition.png\", dpi=150); plt.show()\n"
      ],
      "id": "MNx7haZyBGcY"
    },
