      "source": [
        "# 2.5.1 Correlations among R, F and log1p(M)\n",
        "import seaborn as sns\n",
        "pear, spear = feat[[\"R\", \"F\", \"logM\"]].corr(), feat[[\"R\", \"F\", \"logM\"]].corr(method=\"spearman\")\n",
        "print(\"Pearson:\"); display(pear.round(3)); print(\"Spearman:\"); display(spear.round(3))\n",
        "ev = PCA().fit(X_rfm).explained_variance_ratio_\n",
        "print(\"Variance share of PC1, PC2, PC3 (standardised R, F, logM):\", ev.round(3), \"| PC1 would be about 0.333 if the features were uncorrelated\")\n",
        "sns.heatmap(pear, annot=True, fmt=\".2f\", cmap=\"RdBu_r\", vmin=-1, vmax=1); plt.title(\"R, F, log1p(M) correlations\"); plt.tight_layout()\n",
        "plt.savefig(\"outputs/rfm_correlations.png\", dpi=150); plt.show()\n"
      ],
      "id": "EzW7b9T4BGcV"
    },
