        "id": "RKp1Ye5gBGcK"
      },
      "outputs": [],
      "source": [
        "import os, io, json, time, platform, datetime as dt\n",
        "import requests\n",
        "import pandas as pd, numpy as np\n",
        "import yfinance as yf\n",
        "from importlib.metadata import version"
      ],
      "id": "RKp1Ye5gBGcK"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "-qre13GKBGcL"
      },
      "source": [
        "# Task 1 — Data Preparation and Feature Engineering"
      ],
      "id": "-qre13GKBGcL"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "pmkeA4nFBGcL"
      },
      "source": [
        "## Task 1.1 — Ticker selection and data acquisition"
      ],
      "id": "pmkeA4nFBGcL"
    },
    {
      "cell_type": "code",
      "execution_count": 42,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "lyk5zlydBGcM",
        "outputId": "f17a0772-d66c-49f6-b689-c8e578576821"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stderr",
          "text": [
            "ERROR:yfinance:\n",
            "1 Failed download:\n",
            "ERROR:yfinance:['FDXF']: YFPricesMissingError('possibly delisted; no price data found  (1d 2021-01-01 -> 2025-01-01) (Yahoo error = \"Data doesn\\'t exist for startDate = 1609477200, endDate = 1735707600\")')\n",
            "ERROR:yfinance:\n",
            "1 Failed download:\n",
            "ERROR:yfinance:['HONA']: YFPricesMissingError('possibly delisted; no price data found  (1d 2021-01-01 -> 2025-01-01) (Yahoo error = \"Data doesn\\'t exist for startDate = 1609477200, endDate = 1735707600\")')\n",
            "ERROR:yfinance:\n",
            "1 Failed download:\n",
            "ERROR:yfinance:['Q']: YFPricesMissingError('possibly delisted; no price data found  (1d 2021-01-01 -> 2025-01-01) (Yahoo error = \"Data doesn\\'t exist for startDate = 1609477200, endDate = 1735707600\")')\n",
            "ERROR:yfinance:\n",
            "2 Failed downloads:\n",
            "ERROR:yfinance:['SNDK', 'VYLR']: YFPricesMissingError('possibly delisted; no price data found  (1d 2021-01-01 -> 2025-01-01) (Yahoo error = \"Data doesn\\'t exist for startDate = 1609477200, endDate = 1735707600\")')\n"
          ]
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Live download completed.\n",
            "Retrieval date: 2026-11-24\n",
            "Tickers listed: 503 | duplicates: 0\n",
            "Shares in download: 503\n",
            "Benchmark present: True | sessions: 1005\n",
            "Period: 2021-01-04 to 2024-12-31 (end date exclusive)\n",
            "Shares with full history: 488\n",
            "Shares with partial history: 10\n",
            "Shares with no data: 5\n",
            "\n",
            "Current members added after 2021-01-01 : 89 of 503\n"
          ]
        }
      ],
      "source": [
        "START, END = \"2021-01-01\", \"2025-01-01\"\n",
        "BENCH      = \"^GSPC\"\n",
        "WIKI_URL   = \"https://en.wikipedia.org/wiki/List_of_S%26P_500_companies\"\n",
        "DATA_DIR, OUT_DIR = \"data\", \"outputs\"\n",
        "REFRESH    = True\n",
        "BATCH      = 100\n",
        "os.makedirs(DATA_DIR, exist_ok=True)\n",
        "os.makedirs(OUT_DIR, exist_ok=True)\n",
        "\n",
        "\n",
        "def get_constituents():\n",
        "    html = requests.get(WIKI_URL, headers={\"User-Agent\": \"Mozilla/5.0\"}, timeout=30).text\n",
        "    with open(f\"{DATA_DIR}/wikipedia_sp500_page.html\", \"w\", encoding=\"utf-8\") as f:\n",
        "        f.write(html)\n",
        "\n",
        "    table = pd.read_html(io.StringIO(html))[0]\n",
        "    c = table[[\"Symbol\", \"Security\", \"GICS Sector\", \"GICS Sub-Industry\", \"Date added\"]].copy()\n",
        "    c[\"Ticker\"] = c[\"Symbol\"].str.replace(\".\", \"-\", regex=False)\n",
        "    c[\"retrieval_utc\"] = dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\")\n",
        "    c[\"retrieval_date\"] = dt.date.today().isoformat()\n",
        "    c[\"source_url\"] = WIKI_URL\n",
        "    c.to_csv(f\"{DATA_DIR}/sp500_constituents.csv\", index=False)\n",
        "    return c\n",
        "\n",
        "\n",
        "def download_prices(tickers):\n",
        "    frames = []\n",
        "    failed = []\n",
        "    for i in range(0, len(tickers), BATCH):\n",
        "        chunk = tickers[i:i + BATCH]\n",
        "        for attempt in range(3):\n",
        "            try:\n",
        "                r = yf.download(chunk, start=START, end=END, auto_adjust=False, progress=False)\n",
        "                if not r.empty:\n",
        "                    frames.append(r)\n",
        "                    break\n",
        "            except Exception as e:\n",
        "                print(\"Batch\", i // BATCH, \"attempt\", attempt + 1, \"failed:\", e)\n",
        "            time.sleep(2)\n",
        "        else:\n",
        "            failed += chunk\n",
        "\n",
        "    raw = pd.concat(frames, axis=1)\n",
        "    raw = raw.loc[:, ~raw.columns.duplicated()]\n",
        "\n",
        "\n",
        "    raw[\"Close\"].to_csv(f\"{DATA_DIR}/daily_prices.csv\")\n",
        "    raw[\"Adj Close\"].to_csv(f\"{DATA_DIR}/adjusted_prices.csv\")\n",
        "    raw[\"Volume\"].to_csv(f\"{DATA_DIR}/volume.csv\")\n",
        "    return failed\n",
        "\n",
        "live_ok = False\n",
        "failed_batches = []\n",
        "if REFRESH:\n",
        "    try:\n",
        "        cons = get_constituents()\n",
        "        failed_batches = download_prices(cons[\"Ticker\"].tolist() + [BENCH])\n",
        "        live_ok = True\n",
        "        print(\"Live download completed.\")\n",
        "    except Exception as e:\n",
        "        print(\"Live download failed, using saved snapshots:\", e)\n",
        "\n",
        "\n",
        "cons  = pd.read_csv(f\"{DATA_DIR}/sp500_constituents.csv\")\n",
        "close = pd.read_csv(f\"{DATA_DIR}/daily_prices.csv\",    index_col=0, parse_dates=True)\n",
        "adj   = pd.read_csv(f\"{DATA_DIR}/adjusted_prices.csv\", index_col=0, parse_dates=True)\n",
        "vol   = pd.read_csv(f\"{DATA_DIR}/volume.csv\",          index_col=0, parse_dates=True)\n",
        "\n",
        "\n",
        "tick = cons[\"Ticker\"].tolist()\n",
        "n_sessions = int(adj[BENCH].notna().sum())\n",
        "coverage = adj.drop(columns=[BENCH]).notna().sum()\n",
        "\n",
        "print(\"Retrieval date:\", cons[\"retrieval_date\"].iloc[0])\n",
        "print(\"Tickers listed:\", len(tick), \"| duplicates:\", pd.Series(tick).duplicated().sum())\n",
        "print(\"Shares in download:\", sum(t in adj.columns for t in tick))\n",
        "print(\"Benchmark present:\", BENCH in adj.columns, \"| sessions:\", n_sessions)\n",
        "print(\"Period:\", adj.index.min().date(), \"to\", adj.index.max().date(), \"(end date exclusive)\")\n",
        "print(\"Shares with full history:\", int((coverage == n_sessions).sum()))\n",
        "print(\"Shares with partial history:\", int(((coverage > 0) & (coverage < n_sessions)).sum()))\n",
        "print(\"Shares with no data:\", int((coverage == 0).sum()))\n",
        "\n",
        "\n",
        "added = pd.to_datetime(cons[\"Date added\"], errors=\"coerce\")\n",
        "late = cons.loc[added > pd.Timestamp(START), [\"Ticker\", \"Security\", \"Date added\"]]\n",
        "print(\"\\nCurrent members added after\", START, \":\", len(late), \"of\", len(cons))\n",
        "late.to_csv(f\"{DATA_DIR}/constituents_added_after_start.csv\", index=False)\n",
        "\n",
        "\n",
        "manifest = {\n",
        "    \"study_start\": START,\n",
        "    \"study_end_exclusive\": END,\n",
        "    \"benchmark\": BENCH,\n",
        "    \"price_fields\": \"auto_adjust=False; Close, Adj Close and Volume saved\",\n",
        "    \"why_yfinance\": \"gives adjusted prices and volume, no API key needed; unofficial (limitation)\",\n",
        "    \"live_download_this_run\": live_ok,\n",
        "    \"failed_batches\": failed_batches,\n",
        "    \"python\": platform.python_version(),\n",
        "    \"packages\": {p: version(p) for p in [\"pandas\", \"numpy\", \"yfinance\", \"lxml\", \"requests\"]},\n",
        "}\n",
        "with open(f\"{DATA_DIR}/acquisition_manifest.json\", \"w\") as f:\n",
        "    json.dump(manifest, f, indent=2, default=str)\n"
      ],
      "id": "lyk5zlydBGcM"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "tP01wnLPBGcN"
      },
      "source": [
        "## Task 1.2 — Data validation and alignment"
      ],
      "id": "tP01wnLPBGcN"
    },
    {
      "cell_type": "code",
      "execution_count": 43,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "TuzfZOHZBGcN",
        "outputId": "5803c553-a21b-445d-cf79-b4b9981553d4"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Before cleaning (dates, shares): (1005, 503) | plus benchmark ^GSPC\n",
            "Data source: live download = True\n",
            "Period covered: 2021-01-04 to 2024-12-31 | 1005 benchmark sessions\n",
            "\n",
            "Duplicate dates (adj, close, vol): 0 0 0\n",
            "Dates sorted: True\n",
            "Weekend dates: 0\n",
            "\n",
            "Missing values in each panel (shares only):\n",
            "Close | null cells: 9211 | shares with any null: 15\n",
            "Adj Close | null cells: 9211 | shares with any null: 15\n",
            "Volume | null cells: 9211 | shares with any null: 15\n",
            "Shares starting after the first benchmark date: 10\n",
            "Latest listings:\n",
            " GEHC   2022-12-15\n",
            "VLTO   2023-10-04\n",
            "RDDT   2024-03-21\n",
            "SOLV   2024-03-26\n",
            "GEV    2024-03-27\n",
            "dtype: datetime64[ns]\n",
            "\n",
            "Non-positive price cells: 0\n",
            "Negative volume cells: 0\n",
            "Zero volume cells: 451 | shares affected: 2\n",
            "\n",
            "After cleaning (dates, shares): (1005, 486)\n",
            "Shares removed: 17 of 503\n",
            "\n",
            "Exclusion reasons:\n",
            "exclusion_reason\n",
            "missing data on N dates (late listing or gaps)    10\n",
            "all prices missing                                 5\n",
            "zero-volume days (N)                               2\n",
            "Name: count, dtype: int64\n",
            "\n",
            "Shares where Close and Adj Close returns differ by more than 2% (dividends): 21\n",
            "Daily Close moves above 40%:\n",
            "Ticker       Date  Close_return  Volume_vs_20d_mean                    Decision\n",
            "    BE 2024-11-15         0.592                 8.2 retain: genuine price shock\n",
            "  CVNA 2022-08-05         0.401                 4.4 retain: genuine price shock\n",
            "  CVNA 2022-12-07        -0.429                 5.8 retain: genuine price shock\n",
            "  CVNA 2023-01-12         0.460                 5.6 retain: genuine price shock\n",
            "  CVNA 2023-06-08         0.560                 8.5 retain: genuine price shock\n",
            "  CVNA 2023-07-19         0.402                 4.2 retain: genuine price shock\n",
            "  DXCM 2024-07-26        -0.407                19.4 retain: genuine price shock\n",
            "    GL 2024-04-11        -0.531                26.1 retain: genuine price shock\n",
            "\n",
            "Weekly prices before dropping incomplete weeks: (209, 487)\n",
            "Weekly prices after dropping incomplete weeks: (208, 487)\n",
            "Aligned weekly returns: 207 | first week: 2021-01-15 | last week: 2024-12-27\n",
            "Holiday-shortened weeks kept: 37\n",
            "\n",
            "Current members that joined after 2021-01-01 : 89 of 503\n",
            "Of these, retained: 72\n",
            "\n",
            "Final share count for Task 1.3: 486 | aligned weekly returns: 207\n"
          ]
        }
      ],
      "source": [
        "\n",
        "cons  = pd.read_csv(f\"{DATA_DIR}/sp500_constituents.csv\")\n",
        "close = pd.read_csv(f\"{DATA_DIR}/daily_prices.csv\",    index_col=0, parse_dates=True)\n",
        "adj   = pd.read_csv(f\"{DATA_DIR}/adjusted_prices.csv\", index_col=0, parse_dates=True)\n",
        "vol   = pd.read_csv(f\"{DATA_DIR}/volume.csv\",          index_col=0, parse_dates=True)\n",
        "with open(f\"{DATA_DIR}/acquisition_manifest.json\") as f:\n",
        "    man = json.load(f)\n",
        "\n",
        "\n",
        "cal = adj[BENCH].dropna().index\n",
        "shares = [t for t in cons[\"Ticker\"] if t in adj.columns]\n",
        "\n",
        "print(\"Before cleaning (dates, shares):\", (len(cal), len(shares)), \"| plus benchmark\", BENCH)\n",
        "print(\"Data source: live download =\", man[\"live_download_this_run\"])\n",
        "print(\"Period covered:\", cal.min().date(), \"to\", cal.max().date(), \"|\", len(cal), \"benchmark sessions\")\n",
        "\n",
        "\n",
        "print(\"\\nDuplicate dates (adj, close, vol):\",\n",
        "      adj.index.duplicated().sum(), close.index.duplicated().sum(), vol.index.duplicated().sum())\n",
        "print(\"Dates sorted:\", adj.index.is_monotonic_increasing)\n",
        "print(\"Weekend dates:\", (adj.index.dayofweek >= 5).sum())\n",
        "\n",
        "\n",
        "print(\"\\nMissing values in each panel (shares only):\")\n",
        "for name, d in {\"Close\": close, \"Adj Close\": adj, \"Volume\": vol}.items():\n",
        "    print(name, \"| null cells:\", int(d[shares].isna().sum().sum()),\n",
        "          \"| shares with any null:\", int((d[shares].isna().sum() > 0).sum()))\n",
        "\n",
        "first_valid = adj[shares].apply(lambda s: s.first_valid_index())\n",
        "print(\"Shares starting after the first benchmark date:\", int((first_valid > cal.min()).sum()))\n",
        "print(\"Latest listings:\\n\", first_valid[first_valid > cal.min()].sort_values().tail(5))\n",
        "\n",
        "\n",
        "print(\"\\nNon-positive price cells:\", int((adj[shares] <= 0).sum().sum() + (close[shares] <= 0).sum().sum()))\n",
        "print(\"Negative volume cells:\", int((vol[shares] < 0).sum().sum()))\n",
        "print(\"Zero volume cells:\", int((vol[shares] == 0).sum().sum()),\n",
        "      \"| shares affected:\", int((vol[shares] == 0).any().sum()))\n",
        "\n",
        "\n",
        "rows = []\n",
        "for t in cons[\"Ticker\"]:\n",
        "    reason = \"\"\n",
        "    if t not in adj.columns:\n",
        "        reason = \"no data returned by Yahoo Finance\"\n",
        "    else:\n",
        "        a = adj[t].reindex(cal)\n",
        "        c = close[t].reindex(cal)\n",
        "        v = vol[t].reindex(cal)\n",
        "        n_missing = max(a.isna().sum(), c.isna().sum(), v.isna().sum())\n",
        "\n",
        "        if a.isna().all():\n",
        "            reason = \"all prices missing\"\n",
        "        elif n_missing > 0:\n",
        "            reason = f\"missing data on {n_missing} dates (late listing or gaps)\"\n",
        "        elif (a <= 0).any() or (c <= 0).any():\n",
        "            reason = \"non-positive price\"\n",
        "        elif (v < 0).any():\n",
        "            reason = \"negative volume\"\n",
        "        elif (v == 0).any():\n",
        "            reason = f\"zero-volume days ({int((v == 0).sum())})\"\n",
        "    rows.append((t, reason == \"\", reason))\n",
        "\n",
        "log = pd.DataFrame(rows, columns=[\"Ticker\", \"retained\", \"exclusion_reason\"]).set_index(\"Ticker\")\n",
        "keep = log.index[log[\"retained\"]].tolist()\n",
        "\n",
        "print(\"\\nAfter cleaning (dates, shares):\", (len(cal), len(keep)))\n",
        "print(\"Shares removed:\", len(log) - len(keep), \"of\", len(log))\n",
        "print(\"\\nExclusion reasons:\")\n",
        "print(log.loc[~log[\"retained\"], \"exclusion_reason\"].str.replace(r\"\\d+\", \"N\", regex=True).value_counts())\n",
        "\n",
        "\n",
        "assert adj[keep].loc[cal].notna().all().all()\n",
        "assert close[keep].loc[cal].notna().all().all()\n",
        "assert vol[keep].loc[cal].notna().all().all()\n",
        "\n",
        "\n",
        "c_ret = close[keep].pct_change(fill_method=None)\n",
        "a_ret = adj[keep].pct_change(fill_method=None)\n",
        "\n",
        "gaps = ((c_ret - a_ret).abs() > 0.02).any().sum()\n",
        "print(\"\\nShares where Close and Adj Close returns differ by more than 2% (dividends):\", int(gaps))\n",
        "\n",
        "\n",
        "vol_ratio = vol[keep] / vol[keep].shift(1).rolling(20).mean()\n",
        "review = []\n",
        "for t in keep:\n",
        "    for d in c_ret.index[c_ret[t].abs() > 0.40]:\n",
        "        ratio = 1 + c_ret.at[d, t]\n",
        "        split_like = any(abs(ratio - r) / r < 0.05 for r in (0.5, 1/3, 0.25, 0.2, 0.1, 2, 3, 4, 5, 10))\n",
        "        same = abs(c_ret.at[d, t] - a_ret.at[d, t]) < 0.02\n",
        "        if same and vol_ratio.at[d, t] >= 2 and not split_like:\n",
        "            decision = \"retain: genuine price shock\"\n",
        "        else:\n",
        "            decision = \"MANUAL REVIEW\"\n",
        "        review.append([t, d.date(), round(c_ret.at[d, t], 3), round(vol_ratio.at[d, t], 1), decision])\n",
        "\n",
        "review = pd.DataFrame(review, columns=[\"Ticker\", \"Date\", \"Close_return\", \"Volume_vs_20d_mean\", \"Decision\"])\n",
        "review.to_csv(f\"{OUT_DIR}/corporate_action_review.csv\", index=False)\n",
        "print(\"Daily Close moves above 40%:\")\n",
        "print(review.to_string(index=False) if len(review) else \"none\")\n",
        "\n",
        "\n",
        "P = adj[keep + [BENCH]].loc[cal]\n",
        "wk = P.resample(\"W-FRI\").last()\n",
        "\n",
        "print(\"\\nWeekly prices before dropping incomplete weeks:\", wk.shape)\n",
        "wk = wk[(wk.index - pd.Timedelta(days=4) >= pd.Timestamp(START)) & (wk.index < pd.Timestamp(END))]\n",
        "print(\"Weekly prices after dropping incomplete weeks:\", wk.shape)\n",
        "\n",
        "wret = wk.pct_change(fill_method=None).iloc[1:]\n",
        "assert wret.isna().sum().sum() == 0, \"missing weekly returns remain\"\n",
        "\n",
        "print(\"Aligned weekly returns:\", len(wret), \"| first week:\", wret.index.min().date(),\n",
        "      \"| last week:\", wret.index.max().date())\n",
        "print(\"Holiday-shortened weeks kept:\", int((P[BENCH].resample(\"W-FRI\").count().reindex(wk.index) < 5).sum()))\n",
        "\n",
        "\n",
        "added = pd.to_datetime(cons[\"Date added\"].astype(str).str.extract(r\"(\\d{4}-\\d{2}-\\d{2})\")[0], errors=\"coerce\")\n",
        "late = cons.loc[added > pd.Timestamp(START), \"Ticker\"]\n",
        "print(\"\\nCurrent members that joined after\", START, \":\", len(late), \"of\", len(cons))\n",
        "print(\"Of these, retained:\", int(late.isin(keep).sum()))\n",
        "\n",
        "\n",
        "\n",
        "log.reset_index().to_csv(f\"{DATA_DIR}/final_inclusion_exclusion_log.csv\", index=False)\n",
        "pd.Series(keep, name=\"Ticker\").to_csv(f\"{DATA_DIR}/final_tickers.csv\", index=False)\n",
        "wk.to_csv(f\"{DATA_DIR}/weekly_adj_prices.csv\")\n",
        "wret.to_csv(f\"{DATA_DIR}/weekly_returns.csv\")\n",
        "\n",
        "man[\"task_1_2\"] = {\"week_rule\": \"W-FRI last adj close; incomplete first/final weeks dropped; holiday weeks kept\",\n",
        "                   \"aligned_weekly_obs\": len(wret), \"final_shares\": len(keep)}\n",
        "with open(f\"{DATA_DIR}/acquisition_manifest.json\", \"w\") as f:\n",
        "    json.dump(man, f, indent=2, default=str)\n",
        "\n",
        "print(\"\\nFinal share count for Task 1.3:\", len(keep), \"| aligned weekly returns:\", len(wret))\n"
      ],
      "id": "TuzfZOHZBGcN"
    },
    {
