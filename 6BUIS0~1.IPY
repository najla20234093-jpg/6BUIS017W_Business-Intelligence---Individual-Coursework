    {
      "cell_type": "markdown",
      "metadata": {
        "id": "-gHceX1ZBGcS"
      },
      "source": [
        "## Task 1.4.3 — Monetary"
      ],
      "id": "-gHceX1ZBGcS"
    },
    {
      "cell_type": "code",
      "execution_count": 48,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Gwpy62N4BGcS",
        "outputId": "b7b00d0a-7714-4a82-c43f-6ae0dd3877c8"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Observation date: 2024-12-31\n",
            "60-session window: 2024-10-07 to 2024-12-31 | sessions: 60\n",
            "Shares with no event (R missing): 0\n",
            "Shares with R = 0 (event on observation date): 0\n",
            "           R      F             M\n",
            "count  486.0  486.0  4.860000e+02\n",
            "mean    20.4    3.0  3.940419e+10\n",
            "std     21.3    1.3  1.291388e+11\n",
            "min      4.0    0.0  1.297483e+09\n",
            "25%     11.0    2.0  1.019517e+10\n",
            "50%     11.0    3.0  1.668382e+10\n",
            "75%     14.8    4.0  3.227689e+10\n",
            "max    222.0    8.0  1.847697e+12\n",
            "Manual checks passed for AAPL\n"
          ]
        }
      ],
      "source": [
        "#  1.4.3 Monetary (M)\n",
        "# M = sum of daily Close x Volume over the latest 60 sessions (USD)\n",
        "M = (c.loc[win] * v.loc[win]).sum()\n",
        "\n",
        "rfm = pd.DataFrame({\"last_event\": last_event, \"R\": R, \"F\": F, \"M\": M})\n",
        "\n",
        "# Shares with no high-volume day are excluded from RFM clustering\n",
        "no_event = rfm.index[rfm[\"R\"].isna()]\n",
        "pd.DataFrame({\"Ticker\": no_event,\n",
        "              \"Reason\": \"no high-volume day; R missing, not set to 0\"}).to_csv(f\"{OUT_DIR}/no_event_exclusions.csv\", index=False)\n",
        "rfm.to_csv(f\"{OUT_DIR}/rfm_raw.csv\")\n",
        "\n",
        "# Checks\n",
        "print(\"Observation date:\", OBS_DATE.date())\n",
        "print(\"60-session window:\", win[0].date(), \"to\", win[-1].date(), \"| sessions:\", len(win))\n",
        "print(\"Shares with no event (R missing):\", len(no_event))\n",
        "print(\"Shares with R = 0 (event on observation date):\", int((rfm[\"R\"] == 0).sum()))\n",
        "print(rfm[[\"R\", \"F\", \"M\"]].describe().round(1))\n",
        "\n",
        "# Check one share by hand (second method)\n",
        "t = \"AAPL\" if \"AAPL\" in keep else keep[len(keep) // 2]\n",
        "vals = v[t].values\n",
        "days = [j for j in range(20, len(vals)) if vals[j] > 2 * vals[j-20:j].mean()]\n",
        "assert v.index[days[-1]] == last_event[t]\n",
        "assert (OBS_DATE - v.index[days[-1]]).days == R[t]\n",
        "assert sum(v.index[j] in win for j in days) == F[t]\n",
        "assert np.isclose(M[t], (c[t].loc[win] * v[t].loc[win]).sum())\n",
        "print(\"Manual checks passed for\", t)\n"
      ],
      "id": "Gwpy62N4BGcS"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "Cak9mb6iBGcS"
      },
      "source": [
        "## Task 1.5 — Metric interpretation and supporting evidence"
      ],
      "id": "Cak9mb6iBGcS"
    },
    {
      "cell_type": "code",
      "execution_count": 49,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "vODiOqXRBGcS",
        "outputId": "c7fea191-b38e-49f6-8069-e4842256b76c"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Shares: downloaded 503 | excluded 17 ({'1.2 validation': 17}) | final common set 486\n",
            "Checks passed: threshold alignment (15 share-days), 20-session baseline available for all 60 window days (first baseline date 2021-02-02), no-event shares 0 left missing, common valid set n = 486.\n",
            "                     mean   median       std     min        max     skew\n",
            "MeanWeeklyReturn   0.0029   0.0026    0.0027 -0.0045     0.0178   0.8675\n",
            "Beta               0.9737   0.9506    0.4073  0.0555     3.7786   1.1036\n",
            "R                 20.4074  11.0000   21.3424  4.0000   222.0000   3.6458\n",
            "F                  2.9897   3.0000    1.3308  0.0000     8.0000   0.4247\n",
            "M (USD bn)        39.4042  16.6838  129.1388  1.2975  1847.6974  11.6838\n"
          ]
        }
      ],
      "source": [
        "valid = [s for s in keep if s not in set(no_event)]\n",
        "feat = pd.concat([feat13[[\"MeanWeeklyReturn\", \"Beta\"]], rfm[[\"R\", \"F\", \"M\"]]], axis=1).loc[valid]\n",
        "feat[\"logM\"] = np.log1p(feat.M)\n",
        "assert feat[[\"MeanWeeklyReturn\", \"Beta\", \"R\", \"F\", \"M\"]].notna().all().all(), \"common valid set has missing values\"\n",
        "\n",
        "# Load exclusion logs to reconstruct counts\n",
        "excl = pd.read_csv(f\"{DATA_DIR}/final_inclusion_exclusion_log.csv\")\n",
        "excl = excl[~excl[\"retained\"]]\n",
        "\n",
        "# inclusion / exclusion log (one row per share removed, with stage and reason) + final counts\n",
        "log = pd.concat([excl[[\"Ticker\", \"exclusion_reason\"]].rename(columns={\"exclusion_reason\": \"Reason\"}).assign(Stage=\"1.2 validation\"),\n",
        "                 pd.DataFrame({\"Ticker\": no_event, \"Reason\": \"no high-volume event; R missing (not set to 0)\", \"Stage\": \"1.4 RFM\"})])[[\"Ticker\", \"Stage\", \"Reason\"]]\n",
        "log.to_csv(\"outputs/inclusion_exclusion_log.csv\", index=False); feat.to_csv(\"outputs/feature_table.csv\")\n",
        "print(f\"Shares: downloaded {len(adj.columns) - 1} | excluded {len(log)} ({log.Stage.value_counts().to_dict()}) | final common set {len(feat)}\")\n",
        "\n",
        "# checks - threshold alignment, history sufficiency, no-event handling\n",
        "rng = np.random.default_rng(42)\n",
        "for s in rng.choice(valid, 5, replace=False):\n",
        "    for i in rng.integers(20, len(v), 3):\n",
        "        prior = v[s].iloc[i - 20:i].mean()\n",
        "        assert bool(event[s].iloc[i]) == (v[s].iloc[i] > 2 * prior), (s, i)\n",
        "assert base.loc[win, valid].notna().all().all(), \"window days lack a full 20-session baseline\"\n",
        "assert v.index.get_loc(win[0]) >= 20 and len(win) == 60\n",
        "assert rfm.loc[no_event, \"R\"].isna().all() and (feat.R.notna().all())\n",
        "print(f\"Checks passed: threshold alignment (15 share-days), 20-session baseline available for all 60 window days \"\n",
        "      f\"(first baseline date {v.index[20].date()}), no-event shares {len(no_event)} left missing, common valid set n = {len(feat)}.\")\n",
        "\n",
        "# feature summary (original units)\n",
        "summ = feat[[\"MeanWeeklyReturn\", \"Beta\", \"R\", \"F\", \"M\"]].agg([\"mean\", \"median\", \"std\", \"min\", \"max\", \"skew\"]).T\n",
        "summ.loc[\"M\", [\"mean\", \"median\", \"std\", \"min\", \"max\"]] /= 1e9; summ = summ.rename(index={\"M\": \"M (USD bn)\"})\n",
        "summ.to_csv(\"outputs/feature_summary.csv\")\n",
        "print(summ.round(4))\n"
      ],
      "id": "vODiOqXRBGcS"
    },
    {
