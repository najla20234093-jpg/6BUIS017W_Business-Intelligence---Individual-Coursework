        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Share of log1p(M) variance explained by cluster membership: full RFM = 0.001 | R,F only = 0.004\n",
            "Spearman(M, F) = -0.048 | Spearman(M, R) = 0.137\n"
          ]
        }
      ],
      "source": [
        "# 2.5.2 Remove Monetary: Ward on R and F only (same shares, same k, fresh standardisation)\n",
        "from scipy.stats import spearmanr\n",
        "k_sel = K_WARD[\"RFM\"]\n",
        "X_rf = StandardScaler().fit_transform(feat[[\"R\", \"F\"]])\n",
        "feat[\"RF_Ward\"] = relabel(fcluster(linkage(X_rf, \"ward\"), k_sel, \"maxclust\") - 1, feat.F)\n",
        "print(f\"k = {k_sel} | shares = {len(feat)} | ARI full RFM vs R,F only: {adjusted_rand_score(feat.RFM_Ward, feat.RF_Ward):.3f}\")\n",
        "display(pd.crosstab(feat.RFM_Ward, feat.RF_Ward, rownames=[\"Full RFM\"], colnames=[\"R,F only\"]))\n",
        "for col in [\"RFM_Ward\", \"RF_Ward\"]:\n",
        "    print(f\"\\n{col}: traded value (USD bn) and activity by cluster\")\n",
        "    display(feat.groupby(col).agg(n=(\"M\", \"size\"), R_median=(\"R\", \"median\"), F_median=(\"F\", \"median\"),\n",
        "                                  M_median_bn=(\"M_bn\", \"median\"), M_min_bn=(\"M_bn\", \"min\"), M_max_bn=(\"M_bn\", \"max\")).round(2))\n",
        "def eta2(v, lab): return 1 - sum(((v[lab == c] - v[lab == c].mean()) ** 2).sum() for c in np.unique(lab)) / ((v - v.mean()) ** 2).sum()\n",
        "print(\"Share of log1p(M) variance explained by cluster membership: full RFM =\", round(eta2(feat.logM.values, feat.RFM_Ward.values), 3),\n",
        "      \"| R,F only =\", round(eta2(feat.logM.values, feat.RF_Ward.values), 3))\n",
        "print(\"Spearman(M, F) =\", round(spearmanr(feat.M, feat.F)[0], 3), \"| Spearman(M, R) =\", round(spearmanr(feat.M, feat.R)[0], 3))\n",
        "feat.to_csv(\"outputs/feature_table_with_clusters.csv\")\n"
      ],
      "id": "GcQ2odJXBGcV"
    },
