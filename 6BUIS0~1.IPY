      "source": [
        "from scipy.cluster.hierarchy import linkage, dendrogram, fcluster\n",
        "feat[\"Return_pct\"], feat[\"M_bn\"] = feat.MeanWeeklyReturn * 100, feat.M / 1e9\n",
        "Z  = {\"RR\": linkage(X_rr, \"ward\", \"euclidean\"), \"RFM\": linkage(X_rfm, \"ward\", \"euclidean\")}\n",
        "XS = {\"RR\": X_rr, \"RFM\": X_rfm}\n",
        "PROFILE_COLS = {\"RR\": [\"Return_pct\", \"Beta\"], \"RFM\": [\"R\", \"F\", \"M_bn\"]} # medians, original units\n",
        "\n",
        "def diagnose(lab_fn, X): # silhouette and sizes for k = 2..8\n",
        "    rows = []\n",
        "    for k in range(2, 9):\n",
        "        lab = lab_fn(k); n = np.bincount(lab)\n",
        "        rows.append(dict(k=k, silhouette=round(silhouette_score(X, lab), 3), min_size=n.min(), sizes=n.tolist()))\n",
        "    return pd.DataFrame(rows)\n",
        "def choose_k(d):\n",
        "    ok = d[d.min_size >= max(5, 0.05 * len(feat))]\n",
        "    return int(ok.loc[ok.silhouette.idxmax(), \"k\"]) if len(ok) else int(d.loc[d.silhouette.idxmax(), \"k\"])\n",
        "\n",
        "# silhouette and sizes for k\n",
        "ward_diag = {m: diagnose(lambda k, m=m: fcluster(Z[m], k, \"maxclust\") - 1, XS[m]) for m in Z}\n",
        "for m in Z: print(f\"Ward {m}: silhouette and sizes\"); print(ward_diag[m].to_string(index=False))\n",
        "\n",
        "# interpretable profiles for EVERY k: median of each feature in original units, plus cluster size\n",
        "prof = {}\n",
        "for m in Z:\n",
        "    rows = []\n",
        "    for k in range(2, 9):\n",
        "        lab = fcluster(Z[m], k, \"maxclust\")\n",
        "        g = feat.groupby(lab)[PROFILE_COLS[m]].median().round(2)\n",
        "        g[\"n\"] = pd.Series(lab).value_counts().sort_index().values\n",
        "        g.insert(0, \"cluster\", g.index); g.insert(0, \"k\", k); rows.append(g)\n",
        "    prof[m] = pd.concat(rows, ignore_index=True)\n",
        "    prof[m].to_csv(f\"outputs/ward_profiles_by_k_{m}.csv\", index=False)\n",
        "    print(f\"\\nWard {m}: median profile by k (original units; R, F in days, M in USD bn, return in %)\"); display(prof[m])\n",
        "\n",
        "K_WARD = {m: choose_k(ward_diag[m]) for m in Z}\n",
        "# K_WARD = {\"RR\": 3, \"RFM\": 3}\n",
        "print(\"\\nSelected k (Ward):\", K_WARD)\n",
        "\n",
        "# one dendrogram per matrix, with the chosen cut marked\n",
        "fig, ax = plt.subplots(1, 2, figsize=(14, 4.5))\n",
        "for a, m, ttl in [(ax[0], \"RR\", \"Ward dendrogram: mean weekly return + beta\"), (ax[1], \"RFM\", \"Ward dendrogram: R, F, log1p(M)\")]:\n",
        "    dendrogram(Z[m], truncate_mode=\"lastp\", p=30, no_labels=True, color_threshold=0, above_threshold_color=\"#4C78A8\", ax=a)\n",
        "    k = K_WARD[m]; a.axhline((Z[m][-(k - 1), 2] + Z[m][-k, 2]) / 2, color=\"crimson\", ls=\"--\", label=f\"cut for k = {k}\")\n",
        "    a.set_title(ttl); a.set_xlabel(\"shares (30 merged groups shown)\"); a.set_ylabel(\"Ward distance\"); a.legend()\n",
        "plt.tight_layout(); plt.savefig(\"outputs/dendrograms.png\", dpi=150); plt.show()\n"
      ],
      "id": "POdlbbDaBGcT"
    },
