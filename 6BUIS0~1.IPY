      },
      "source": [
        "# Task 3 — Business Intelligence and Critical Review"
      ],
      "id": "77rC8rbnBGcV"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "oVf4J7EiBGcV"
      },
      "source": [
        "## Task 3.1.1 — Grain, facts and dimensions"
      ],
      "id": "oVf4J7EiBGcV"
    },
    {
      "cell_type": "code",
      "execution_count": 54,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "NpANn9aGBGcW",
        "outputId": "f85a424b-4238-4667-e20f-6608d69ffcf9"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "dim_date             rows:    1,005\n",
            "dim_share            rows:      503\n",
            "dim_benchmark        rows:        1\n",
            "fact_daily_price     rows:  488,430\n",
            "fact_weekly_return   rows:  100,602\n",
            "fact_features        rows:      486\n",
            "fact_cluster         rows:    1,944\n"
          ]
        }
      ],
      "source": [
        "import datetime as dt, platform\n",
        "cons = pd.read_csv(\"data/sp500_constituents.csv\")\n",
        "RUN_ID = f\"v1.0_{OBS_DATE.date()}\"\n",
        "long = lambda df, name: df.rename_axis(\"date\").reset_index().melt(\"date\", var_name=\"ticker\", value_name=name)\n",
        "\n",
        "# 3.1.1 Grain, facts and dimensions\n",
        "dim_date = pd.DataFrame({\"date\": adj.index})\n",
        "dim_date[\"week_ending\"] = dim_date.date + pd.to_timedelta((4 - dim_date.date.dt.weekday) % 7, unit=\"D\")   # Friday of that week\n",
        "dim_date[\"month\"] = dim_date.date.dt.to_period(\"M\").astype(str)\n",
        "dim_date[\"quarter\"] = dim_date.date.dt.to_period(\"Q\").astype(str)\n",
        "dim_share = cons.rename(columns={\"GICS Sector\": \"sector\", \"GICS Sub-Industry\": \"sub_industry\", \"Date added\": \"date_added\"})[\n",
        "    [\"Ticker\", \"Security\", \"sector\", \"sub_industry\", \"date_added\"]]\n",
        "dim_benchmark = pd.DataFrame({\"ticker\": [BENCH], \"name\": [\"S&P 500 index\"], \"type\": [\"price index (no dividends)\"]})\n",
        "\n",
        "# Daily facts: grain = one share x one trading date\n",
        "fact_daily = (long(adj[keep], \"adj_close\").merge(long(close[keep], \"close\"))\n",
        "              .merge(long(vol[keep], \"volume\")).merge(long(event[keep].astype(int), \"high_volume_flag\")))\n",
        "fact_daily[\"traded_value\"] = fact_daily.close * fact_daily.volume\n",
        "\n",
        "# Weekly facts: grain = one share x one ending week\n",
        "fact_weekly = long(wret[keep].rename_axis(\"date\"), \"weekly_return\").rename(columns={\"date\": \"week_ending\"})\n",
        "fact_weekly[\"benchmark_return\"] = fact_weekly.week_ending.map(wret[BENCH])\n",
        "\n",
        "# Feature facts: grain = one share x one run\n",
        "fact_features = feat.rename_axis(\"ticker\").reset_index()\n",
        "fact_features.insert(0, \"run_id\", RUN_ID)\n",
        "\n",
        "cl_cols = [c for c in [\"RR_Ward\", \"RR_KM\", \"RFM_Ward\", \"RFM_KM\", \"RF_Ward\"] if c in feat.columns]\n",
        "fact_cluster = (feat[cl_cols].rename_axis(\"ticker\").reset_index().melt(\"ticker\", var_name=\"solution\", value_name=\"cluster\")\n",
        "                .assign(run_id=RUN_ID, k=lambda d: d.groupby(\"solution\").cluster.transform(\"max\")))\n",
        "\n",
        "# Integrity checks\n",
        "assert not fact_daily.duplicated([\"date\", \"ticker\"]).any() and not fact_weekly.duplicated([\"week_ending\", \"ticker\"]).any()\n",
        "assert set(fact_daily.ticker) <= set(dim_share.Ticker) and not fact_features.duplicated([\"run_id\", \"ticker\"]).any()\n",
        "\n",
        "for n, d in [(\"dim_date\", dim_date), (\"dim_share\", dim_share), (\"dim_benchmark\", dim_benchmark),\n",
        "             (\"fact_daily_price\", fact_daily), (\"fact_weekly_return\", fact_weekly),\n",
        "             (\"fact_features\", fact_features), (\"fact_cluster\", fact_cluster)]:\n",
        "    print(f\"{n:20s} rows: {len(d):>8,}\")\n"
      ],
      "id": "NpANn9aGBGcW"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "clFn3qRqBGcW"
      },
      "source": [
        "## Task 3.1.2 — Provenance and calculation history"
      ],
      "id": "clFn3qRqBGcW"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "C7eqbfwHBGcX"
      },
      "outputs": [],
      "source": [
        "# 3.1.2 Provenance and calculation history\n",
        "dim_run = pd.DataFrame([dict(run_id=RUN_ID, calc_version=\"v1.0\",\n",
        "    run_utc=dt.datetime.now(dt.timezone.utc).isoformat(timespec=\"seconds\"),\n",
        "    source=\"Wikipedia constituents + yfinance\",\n",
        "    constituents_retrieved=str(cons.get(\"retrieval_date\", pd.Series([\"unknown\"])).iloc[0]),\n",
        "    study_start=START, study_end_exclusive=END, observation_date=str(OBS_DATE.date()),\n",
        "    baseline_sessions=20, window_sessions=60, volume_multiple=2.0, seed=SEED,\n",
        "    python=platform.python_version(), pandas=pd.__version__)]).dropna(axis=1, how=\"all\")\n",
        "\n",
        "print(\"Calculation run provenance:\")\n",
        "display(dim_run.T.rename(columns={0: \"Value\"}))\n"
      ],
      "id": "C7eqbfwHBGcX"
    },
