      "source": [
        "# 1.4.2 Frequency (F)\n",
        "# F = number of high-volume days in the latest 60 sessions\n",
        "F = event.loc[win].sum()\n",
        "\n",
        "print(\"Task 1.4.2 Frequency summary:\")\n",
        "display(F.describe().to_frame(\"Frequency_days\").round(2))\n"
      ],
