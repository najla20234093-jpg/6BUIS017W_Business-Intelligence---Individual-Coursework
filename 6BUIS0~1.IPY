242701,\n        \"min\": 1.3,\n        \"max\": 4.37,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          1.3,\n          4.37\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"M_max_bn\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 15.810907627331293,\n        \"min\": 1825.34,\n        \"max\": 1847.7,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          1847.7,\n          1825.34\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
