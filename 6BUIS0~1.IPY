      ],
      "source": [
        "# 3.1.3 Analytical and stakeholder support\n",
        "ex = (fact_features[fact_features.run_id == RUN_ID]\n",
        "      .merge(dim_share, left_on=\"ticker\", right_on=\"Ticker\")\n",
        "      .groupby(\"sector\").agg(shares=(\"ticker\", \"size\"), avg_high_volume_days=(\"F\", \"mean\"), avg_traded_value_bn=(\"M\", lambda s: s.mean() / 1e9))\n",
        "      .round(2).sort_values(\"avg_high_volume_days\", ascending=False))\n",
        "display(ex)\n"
      ],
      "id": "q2qN7xjBBGcX"
    },
