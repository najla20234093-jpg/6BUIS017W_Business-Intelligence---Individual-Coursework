      "source": [
        "from sklearn.metrics import adjusted_rand_score\n",
        "def km_diag(X):\n",
        "    rows = []\n",
        "    for k in range(2, 9):\n",
        "        km = KMeans(k, n_init=50, random_state=SEED).fit(X); n = np.bincount(km.labels_)\n",
        "        alt = [KMeans(k, n_init=10, random_state=s).fit_predict(X) for s in (1, 2, 3)]          # initialisation stability\n",
        "        rows.append(dict(k=k, inertia=round(km.inertia_, 1), silhouette=round(silhouette_score(X, km.labels_), 3),\n",
        "                         min_size=n.min(), sizes=n.tolist(), seed_ARI=round(np.mean([adjusted_rand_score(km.labels_, a) for a in alt]), 3)))\n",
        "    return pd.DataFrame(rows)\n",
        "km_d = {m: km_diag(XS[m]) for m in XS}\n",
        "for m in km_d: print(f\"K-means {m}\"); print(km_d[m].to_string(index=False))\n",
        "K_KM = {m: choose_k(km_d[m]) for m in km_d}\n",
        "# K_KM = {\"RR\": 4, \"RFM\": 3}\n",
        "print(\"Selected k (K-means):\", K_KM)\n",
        "\n",
        "fig, ax = plt.subplots(2, 2, figsize=(11, 7))\n",
        "for j, m in enumerate([\"RR\", \"RFM\"]):\n",
        "    ax[0, j].plot(km_d[m].k, km_d[m].inertia, \"o-\"); ax[0, j].set_title(f\"K-means inertia (elbow): {m}\"); ax[0, j].set_xlabel(\"k\")\n",
        "    ax[1, j].plot(km_d[m].k, km_d[m].silhouette, \"o-\", label=\"K-means\"); ax[1, j].plot(ward_diag[m].k, ward_diag[m].silhouette, \"s--\", label=\"Ward\")\n",
        "    ax[1, j].set_title(f\"Silhouette: {m}\"); ax[1, j].set_xlabel(\"k\"); ax[1, j].legend()\n",
        "plt.tight_layout(); plt.savefig(\"outputs/k_selection.png\", dpi=150); plt.show()\n"
      ],
      "id": "WItErUVZBGcU"
    },
