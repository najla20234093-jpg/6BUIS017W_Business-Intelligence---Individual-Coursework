          "text": [
            "Mean pairwise weekly-return correlation, all shares: 0.300\n",
            "  RR_Ward: within clusters 0.301 | between clusters 0.296\n",
            "  RFM_Ward: within clusters 0.305 | between clusters 0.286\n",
            "Shares with Close vs Adj Close gaps above 2%: 21 (returns use Adj Close, M uses Close)\n",
            "Survivorship: 89 of 503 current members joined after 2021-01-01\n",
            "R-F correlation -0.35 | Spearman(M, F) -0.05\n",
            "RFM clusters explain 0% of the variance in log traded value\n"
          ]
        }
      ],
      "source": [
        "# 3.2.3 Critical evaluation and limitations\n",
        "from scipy.stats import spearmanr\n",
        "\n",
        "def eta2(x, g):\n",
        "    x, g = np.asarray(x), np.asarray(g)\n",
        "    return sum(\n",
        "        (g == k).sum() * (x[g == k].mean() - x.mean()) ** 2\n",
        "        for k in np.unique(g)\n",
        "    ) / ((x - x.mean()) ** 2).sum()\n",
        "\n",
        "C = wret[feat.index].corr().values\n",
        "off = ~np.eye(len(C), dtype=bool)\n",
        "\n",
        "print(f\"Mean pairwise weekly-return correlation, all shares: {C[off].mean():.3f}\")\n",
        "\n",
        "for col in [\"RR_Ward\", \"RFM_Ward\"]:\n",
        "    lab = feat[col].values\n",
        "    same = (lab[:, None] == lab[None, :]) & off\n",
        "    diff = (lab[:, None] != lab[None, :]) & off\n",
        "    print(f\"  {col}: within clusters {C[same].mean():.3f} | between clusters {C[diff].mean():.3f}\")\n",
        "\n",
        "gaps = (\n",
        "    (\n",
        "        close[feat.index].pct_change(fill_method=None)\n",
        "        - adj[feat.index].pct_change(fill_method=None)\n",
        "    ).abs() > 0.02\n",
        ").any().sum()\n",
        "\n",
        "print(f\"Shares with Close vs Adj Close gaps above 2%: {gaps} (returns use Adj Close, M uses Close)\")\n",
        "\n",
        "added = pd.to_datetime(cons[\"Date added\"], errors=\"coerce\")\n",
        "print(f\"Survivorship: {int((added > pd.Timestamp(START)).sum())} of {len(cons)} current members joined after {START}\")\n",
        "\n",
        "print(f\"R-F correlation {feat.R.corr(feat.F):.2f} | Spearman(M, F) {spearmanr(feat.M, feat.F)[0]:.2f}\")\n",
        "print(f\"RFM clusters explain {eta2(feat.logM, feat.RFM_Ward):.0%} of the variance in log traded value\")"
      ],
      "id": "_kYBSQXMBGcY"
    }
