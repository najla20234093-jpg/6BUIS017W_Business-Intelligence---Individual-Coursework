      "source": [
        "# Task 2 — Stock Segmentation and Sensitivity Analysis"
      ],
      "id": "ZpyznE0MBGcT"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "jh3q0QrxBGcT"
      },
      "source": [
        "## Task 2.1 — Feature preparation"
      ],
      "id": "jh3q0QrxBGcT"
    },
    {
      "cell_type": "code",
      "execution_count": 50,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 729
        },
        "id": "dP58aXWVBGcT",
        "outputId": "79060258-a043-459c-8518-1cc96ec1a71c"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "                   skew  n |z|>3  n IQR outliers\n",
            "MeanWeeklyReturn   0.86        6              15\n",
            "Beta               1.10        2              10\n",
            "R                  3.63       11             115\n",
            "F                  0.42        5               2\n",
            "M                 11.65        5              45\n",
            "logM               1.08        7              13\n"
          ]
        },
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1200x600 with 6 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ],
      "source": [
        "from scipy.stats import skew\n",
        "from scipy.cluster.hierarchy import linkage, fcluster\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.metrics import silhouette_score\n",
        "import matplotlib.pyplot as plt\n",
        "SEED = 42\n",
        "\n",
        "# two separate feature matrices on the SAME shares\n",
        "rr  = feat[[\"MeanWeeklyReturn\", \"Beta\"]].copy()\n",
        "rfm_df = feat[[\"R\", \"F\"]].assign(logM=np.log1p(feat.M))\n",
        "assert rr.index.equals(rfm_df.index) and rr.notna().all().all() and rfm_df.notna().all().all()\n",
        "\n",
        "# inspect skew and outliers (raw features, then log1p(M))\n",
        "def iqr_out(s): q1, q3 = s.quantile([.25, .75]); i = q3 - q1; return int(((s < q1 - 1.5 * i) | (s > q3 + 1.5 * i)).sum())\n",
        "cols = feat[[\"MeanWeeklyReturn\", \"Beta\", \"R\", \"F\", \"M\", \"logM\"]]\n",
        "insp = pd.DataFrame({\"skew\": cols.apply(skew), \"n |z|>3\": ((cols - cols.mean()).abs() / cols.std() > 3).sum(), \"n IQR outliers\": cols.apply(iqr_out)})\n",
        "print(insp.round(2))\n",
        "cols.hist(bins=40, figsize=(12, 6)); plt.tight_layout(); plt.savefig(\"outputs/feature_distributions.png\", dpi=150); plt.show()\n",
        "\n",
        "# standardise each matrix separately (mean 0, sd 1); R and F kept untransformed, outliers retained\n",
        "X_rr  = pd.DataFrame(StandardScaler().fit_transform(rr),     index=rr.index,     columns=rr.columns)\n",
        "X_rfm = pd.DataFrame(StandardScaler().fit_transform(rfm_df), index=rfm_df.index, columns=rfm_df.columns)\n",
        "assert np.allclose(X_rr.mean(), 0) and np.allclose(X_rfm.std(ddof=0), 1)\n"
      ],
      "id": "dP58aXWVBGcT"
    },
