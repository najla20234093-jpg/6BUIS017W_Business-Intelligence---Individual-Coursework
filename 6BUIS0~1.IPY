        },
        "id": "WItErUVZBGcU",
        "outputId": "f8b4164f-0a21-4740-b2bc-d985900ab8a6"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "K-means RR\n",
            " k  inertia  silhouette  min_size                            sizes  seed_ARI\n",
            " 2    621.6       0.387       143                       [143, 343]     1.000\n",
            " 3    461.2       0.329       119                  [202, 165, 119]     1.000\n",
            " 4    371.6       0.327        40              [132, 154, 40, 160]     1.000\n",
            " 5    309.6       0.341        27          [112, 166, 131, 27, 50]     0.669\n",
